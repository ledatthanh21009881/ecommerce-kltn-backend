{
  "name": "shopswift/php-backend-plain",
  "description": "Plain PHP backend (web + app API) with structured folders.",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.10",
    "cloudinary/cloudinary_php": "^3.1",
    "setasign/fpdf": "^1.8",
    "tecnickcom/tcpdf": "^6.10",
    "dompdf/dompdf": "^3.1",
    "cboden/ratchet": "^0.4.4",
    "firebase/php-jwt": "^6.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
