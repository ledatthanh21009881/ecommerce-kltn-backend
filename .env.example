# Environment Configuration
APP_NAME="ShopSwift Ecommerce"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=3600

# File Upload Configuration
UPLOAD_PATH=storage/uploads
MAX_FILE_SIZE=5242880

# Payment Configuration
PAYMENT_GATEWAY_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# Shipping Configuration
SHIPPING_API_URL=
SHIPPING_API_KEY=

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@shopswift.com
MAIL_FROM_NAME="ShopSwift"

# SMS Configuration
SMS_API_URL=
SMS_API_KEY=

# Third-party API Keys
GOOGLE_MAPS_API_KEY=
FIREBASE_SERVER_KEY=
