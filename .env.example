# Environment Configuration
APP_NAME="VIVIENNE Ecommerce"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL công khai cho app mobile shipper (Docker/VPS).
# Nếu trống: dùng APP_URL hoặc Host của request khi gọi /api/mobile/v1/config.
# Ví dụ: MOBILE_API_PUBLIC_URL=http://103.90.225.212:8000
# MOBILE_API_PUBLIC_URL=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_db
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
# For testing, set short expiry (seconds). Default in config is 3600 (1 hour).
JWT_EXPIRE_TIME=30

# File Upload Configuration
UPLOAD_PATH=storage/uploads
MAX_FILE_SIZE=5242880

# Payment Configuration
PAYMENT_GATEWAY_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# PayOS (Chuyển khoản ngân hàng) - https://my.payos.vn - Lấy từ Thông tin tích hợp / Kênh thanh toán
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_URL=https://api-merchant.payos.vn
# URL gốc frontend cho returnUrl/cancelUrl (vd: http://localhost:3000)
PAYOS_BASE_URL=
# Trên PayOS dashboard: cấu hình Webhook url = https://your-domain.com/api/v1/payments/payos-webhook

# Shipping Configuration
SHIPPING_API_URL=
SHIPPING_API_KEY=

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vivienne.com
MAIL_FROM_NAME="VIVIENNE"
# EmailService (PHPMailer) cũng đọc FROM_EMAIL / FROM_NAME nếu có
FROM_EMAIL=
FROM_NAME="VIVIENNE"

# SMS Configuration
SMS_API_URL=
SMS_API_KEY=

# Third-party API Keys
GOOGLE_MAPS_API_KEY=
# Mapbox Geocoding (PHP) — lat/lng khi lưu địa chỉ / đơn. Có thể trùng token với web NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN.
MAPBOX_ACCESS_TOKEN=
FIREBASE_SERVER_KEY=
